# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
WS_PATH=/ws

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialplay?schema=public
DATABASE_POOL_SIZE=10

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=socialplay
JWT_AUDIENCE=socialplay

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# For production S3:
# STORAGE_PROVIDER=s3
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=socialplay-uploads
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_PUBLIC_URL=https://socialplay-uploads.s3.amazonaws.com

# Redis (for Socket.IO scaling)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (configure for production)
EMAIL_PROVIDER=console
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-user
# EMAIL_SMTP_PASS=your-password
EMAIL_FROM=noreply@socialplay.local

# Push Notifications (configure for production)
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:admin@socialplay.local