{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "pnpm -w run build:packages && node build.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:worker:once": "node dist/worker.js --once",
    "worker:dev": "pnpm -w run build:packages && tsx --env-file=../../.env src/worker.ts --once",
    "worker:dev:loop": "pnpm -w run build:packages && tsx --env-file=../../.env src/worker.ts",
    "preflight:ledger-upgrade": "tsx src/scripts/ledger-upgrade-preflight.ts",
    "scan:ledger-invariants": "tsx src/scripts/ledger-invariant-scan.ts",
    "ledger:runtime-access": "tsx src/scripts/ledger-runtime-access.ts",
    "economics:preview": "tsx src/scripts/game-economics-preview.ts",
    "test:economics": "vitest run --config vitest.economics.config.ts",
    "test:scheduled-practice": "vitest run --config vitest.scheduled-practice.config.ts",
    "worker:scheduled-practice": "tsx src/scripts/scheduled-practice-worker.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:shared-boundary": "node scripts/check-shared-types.mjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "pnpm -w run build:packages && vitest run",
    "test:watch": "pnpm -w run build:packages && vitest",
    "clean": "rm -rf dist",
    "house:recovery": "tsx src/scripts/house-round-recovery.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.8.0",
    "@socialplay/config": "workspace:*",
    "@socialplay/database": "workspace:*",
    "@socialplay/shared": "workspace:*",
    "@socialplay/storage": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drand-client": "1.4.2",
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.0",
    "pino": "^8.16.0",
    "socket.io": "^4.7.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
