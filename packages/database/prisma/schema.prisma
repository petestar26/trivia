generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  displayName  String?
  bio          String?    @db.Text
  avatarUrl    String?
  isVerified   Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  role         UserRole   @default(USER)
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile          Profile?
  ownedGroups      Group[]           @relation("GroupOwner")
  groupMemberships GroupMember[]
  messages         Message[]
  messageReactions MessageReaction[]
  notifications    Notification[]
  wallet           Wallet?
  vipMembership    VipMembership?
  progress         UserProgress?
  xpEvents         UserXpEvent[]
  tasks            UserTask[]
  streak           DailyStreak?
  rewardClaims     RewardClaim[]
  achievements     UserAchievement[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Profile ────────────────────────────────────────────────────

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.Text
  avatarUrl   String?
  coverUrl    String?
  metadata    Json?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── Groups ─────────────────────────────────────────────────────

enum GroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  BANNED
}

model Group {
  id          String      @id @default(uuid())
  ownerId     String
  name        String
  description String?     @db.Text
  imageUrl    String?
  coverUrl    String?
  isPrivate   Boolean     @default(false)
  status      GroupStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner    User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  GroupMember[]
  messages Message[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("groups")
}

// ─── Group Members ──────────────────────────────────────────────

enum GroupMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum GroupMemberStatus {
  ACTIVE
  PENDING
  BANNED
  MUTED
  LEFT
}

model GroupMember {
  id        String            @id @default(uuid())
  groupId   String
  userId    String
  role      GroupMemberRole   @default(MEMBER)
  status    GroupMemberStatus @default(ACTIVE)
  joinedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@map("group_members")
}

// ─── Messages ───────────────────────────────────────────────────

enum MessageType {
  TEXT
  VOICE
  SYSTEM
  GIFT
}

model Message {
  id        String      @id @default(uuid())
  groupId   String
  userId    String
  content   String      @db.Text
  type      MessageType @default(TEXT)
  replyToId String?
  isEdited  Boolean     @default(false)
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  voiceMessage VoiceMessage?

  @@index([groupId, createdAt])
  @@index([userId])
  @@index([replyToId])
  @@map("messages")
}

// ─── Message Reactions ──────────────────────────────────────────

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

model MessageReaction {
  id        String       @id @default(uuid())
  messageId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

// ─── Voice Messages ─────────────────────────────────────────────

model VoiceMessage {
  id         String   @id @default(uuid())
  messageId  String   @unique
  storageKey String
  mimeType   String   @default("audio/ogg")
  duration   Int
  size       Int
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("voice_messages")
}

// ─── Notifications ──────────────────────────────────────────────

enum NotificationType {
  MESSAGE
  MENTION
  REACTION
  GIFT_RECEIVED
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_APPROVED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  ACHIEVEMENT_UNLOCKED
  REWARD_CLAIMED
  LEADERBOARD_UPDATE
  VIP_EXPIRING
  VIP_EXPIRED
  SYSTEM
  MODERATION
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Economy ────────────────────────────────────────────────────

enum CurrencyType {
  COINS
  GAME_POINTS
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum EconomyTransactionType {
  COIN_CREDIT
  COIN_DEBIT
  GAME_POINT_CREDIT
  GAME_POINT_DEBIT
  GIFT_SEND
  GIFT_RECEIVE
}

enum WalletTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
}

enum TransactionReferenceType {
  GIFT
  REWARD
  PURCHASE
  GAME
  ADMIN
  TRANSFER
  DAILY_REWARD
  TASK
  ACHIEVEMENT
  REFUND
}

model Wallet {
  id               String @id @default(uuid())
  userId           String @unique
  coinsBalance     Int    @default(0)
  gamePointsBalance Int   @default(0)
  version          Int    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]
  sentGifts         GiftTransaction[]    @relation("GiftSender")
  receivedGifts     GiftTransaction[]    @relation("GiftRecipient")

  @@map("wallets")
}

model WalletTransaction {
  id            String                   @id @default(uuid())
  walletId      String
  userId        String
  type          EconomyTransactionType
  ledgerType    LedgerType
  currency      CurrencyType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  referenceType TransactionReferenceType
  referenceId   String?
  description   String
  status        WalletTransactionStatus  @default(SUCCEEDED)
  createdAt     DateTime                 @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model Gift {
  id                String       @id @default(uuid())
  name              String
  description       String       @default("")
  imageUrl          String?
  coinPrice         Int
  recipientPointValue Int
  isAnimated        Boolean      @default(false)
  isLimited         Boolean      @default(false)
  limitedQuantity   Int?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  transactions      GiftTransaction[]

  @@index([isActive])
  @@map("gifts")
}

model GiftTransaction {
  id                      String @id @default(uuid())
  senderId                String
  recipientId             String
  giftId                  String
  quantity                Int
  totalCoins              Int
  totalGamePoints         Int
  coinPriceAtTransaction  Int
  pointValueAtTransaction Int
  senderWalletId          String
  recipientWalletId       String
  createdAt               DateTime @default(now())

  sender    Wallet @relation("GiftSender", fields: [senderWalletId], references: [id], onDelete: Restrict)
  recipient Wallet @relation("GiftRecipient", fields: [recipientWalletId], references: [id], onDelete: Restrict)
  gift      Gift   @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([giftId])
  @@index([createdAt])
  @@map("gift_transactions")
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  userId      String
  key         String
  operation   String
  status      String   @default("SUCCEEDED")
  responseKey String?
  createdAt   DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@map("idempotency_records")
}

// ─── VIP ────────────────────────────────────────────────────────

enum VipTier {
  SILVER
  GOLD
  PLATINUM
}

enum VipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model VipMembership {
  id        String    @id @default(uuid())
  userId    String    @unique
  tier      VipTier
  status    VipStatus @default(ACTIVE)
  startedAt DateTime
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([status])
  @@map("vip_memberships")
}

// ─── XP / Levels ────────────────────────────────────────────────

model UserProgress {
  id        String   @id @default(uuid())
  userId    String   @unique
  xp        Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpEvents UserXpEvent[]

  @@map("user_progress")
}

model UserXpEvent {
  id            String  @id @default(uuid())
  userId        String
  xp            Int
  reason        String
  referenceType String
  referenceId   String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents duplicate XP award for the same action/reference
  @@unique([referenceType, referenceId, userId])
  @@index([userId, createdAt])
  @@map("user_xp_events")
}

// ─── Daily Tasks ────────────────────────────────────────────────

enum TaskType {
  DAILY
  WEEKLY
  MONTHLY
  ONE_TIME
  ACHIEVEMENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CLAIMED
  EXPIRED
}

model TaskDefinition {
  id            String   @id @default(uuid())
  key           String   @unique
  type          TaskType
  title         String
  description   String?  @db.Text
  target        Int      @default(1)
  xpReward      Int      @default(0)
  coinReward    Int      @default(0)
  gamePointReward Int    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userTasks UserTask[]

  @@index([type])
  @@index([isActive])
  @@map("task_definitions")
}

model UserTask {
  id          String     @id @default(uuid())
  userId      String
  taskId      String
  progress    Int        @default(0)
  status      TaskStatus @default(IN_PROGRESS)
  periodKey   String?    // canonical date (YYYY-MM-DD) for DAILY tasks
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task TaskDefinition @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, periodKey])
  @@index([userId, status])
  @@index([taskId])
  @@map("user_tasks")
}

// ─── Streaks ────────────────────────────────────────────────────

model DailyStreak {
  id             String  @id @default(uuid())
  userId         String  @unique
  currentStreak  Int     @default(0)
  longestStreak  Int     @default(0)
  lastActivityDay String? // canonical UTC date (YYYY-MM-DD)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_streaks")
}

// ─── Rewards ────────────────────────────────────────────────────

model RewardClaim {
  id             String  @id @default(uuid())
  userId         String
  sourceType     String
  sourceId       String
  xpReward       Int     @default(0)
  coinReward     Int     @default(0)
  gamePointReward Int    @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A given reward source can only be claimed once per user
  @@unique([userId, sourceType, sourceId])
  @@index([userId])
  @@map("reward_claims")
}

// ─── Achievements ───────────────────────────────────────────────

enum AchievementCategory {
  SOCIAL
  CHAT
  ECONOMY
  GAME
  ENGAGEMENT
  MILESTONE
}

model Achievement {
  id          String              @id @default(uuid())
  key         String              @unique
  category    AchievementCategory
  title       String
  description String?             @db.Text
  xpReward    Int                 @default(0)
  coinReward  Int                 @default(0)
  gamePointReward Int             @default(0)
  iconUrl     String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}
