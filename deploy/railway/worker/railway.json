{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm run build:packages && pnpm --filter api build",
    "watchPatterns": ["apps/api/src/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter api start:worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
